#!/bin/bash
# Extend the stock updater with user-owned collectors, preserving its flags.
# The existing panel timer, opening refresh and manual refresh all use this path.
# A bundled collector named like a stock one replaces it.
collector_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
stock_dir="${OMARCHY_PATH:-/usr/share/omarchy}/bin"
usage_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
flags=()
only=()
declare -A excluded
args=("$@")
while (( $# )); do
  case "$1" in
    --force | --limits-only) flags+=("$1") ;;
    --except)
      [[ $# -ge 2 ]] || exit 2
      excluded[$2]=1
      shift ;;
    *) only+=("$1") ;;
  esac
  shift
done

agents=(cursor deepseek)
# The Codex and Claude wrappers reuse the stock collectors, so they need one installed.
for agent in codex claude; do
  if [[ -x $stock_dir/omarchy-agent-usage-$agent ]]; then
    agents+=("$agent")
    args+=(--except "$agent")
  fi
done

wanted() {
  [[ -n ${excluded[$1]} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  local candidate
  for candidate in "${only[@]}"; do
    [[ $candidate == "$1" ]] && return 0
  done
  return 1
}

collect() {
  local agent=$1 record tmp
  if record=$("$collector_dir/omarchy-agent-usage-$agent" "${flags[@]}") &&
    jq -e --arg id "$agent" 'type == "object" and .id == $id' >/dev/null 2>&1 <<<"$record" &&
    mkdir -p "$usage_dir" && tmp=$(mktemp "$usage_dir/.$agent.XXXXXX"); then
    if ! { printf '%s\n' "$record" >"$tmp" && mv "$tmp" "$usage_dir/$agent.json"; }; then
      rm -f "$tmp"
      return 1
    fi
  else
    echo "omarchy-agent-usage-update: $agent collector failed" >&2
    return 1
  fi
}

"$stock_dir/omarchy-agent-usage-update" "${args[@]}" &
pids=($!)
for agent in "${agents[@]}"; do
  wanted "$agent" || continue
  collect "$agent" &
  pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done
exit "$status"
